#!/bin/sh
set -eu
if [ "$2" != 'https://github.com/felixchenyijun/explainers.git' ]; then
  printf '%s\n' 'Refusing push: only the personal felixchenyijun/explainers HTTPS origin is allowed.' >&2
  exit 1
fi
root=$(git rev-parse --show-toplevel)
"$root/scripts/gh-personal" api user --jq .login >/dev/null
